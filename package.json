{
  "author": "Adrien Lacourpaille",
  "description": "Small, typed, dependency-free TypeScript packages",
  "devDependencies": {
    "@adrienlcp/biome-config": "workspace:*",
    "@biomejs/biome": "2.6.4",
    "@changesets/cli": "^3.0.3",
    "@cspell/dict-fr-fr": "^2.3.2",
    "@vitest/coverage-v8": "5.1.0",
    "cspell": "^10.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "license": "MIT",
  "name": "adrienlcp-packages",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "changeset": "changeset",
    "deps:upgrade": "corepack use pnpm@latest && pnpm -r up -L && biome migrate --write",
    "exports": "node apps/docs/scripts/write-exports-index.ts",
    "lint": "biome check --write",
    "lint:ci": "biome ci",
    "release": "pnpm build && changeset publish",
    "spell": "git ls-files --cached --others --exclude-standard | cspell --no-progress --file-list stdin",
    "test": "pnpm -r test",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/browser && tsc --noEmit -p packages/prerender && tsc --noEmit -p packages/react && tsc --noEmit -p packages/react-aria && tsc --noEmit -p packages/react-router && tsc --noEmit -p packages/safe-storage && tsc --noEmit -p packages/theme-preference",
    "validate": "pnpm build && pnpm typecheck && pnpm lint:ci && pnpm spell && pnpm test"
  },
  "type": "module",
  "version": "0.0.0"
}

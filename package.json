{
  "author": "Adrien Lacourpaille",
  "description": "Small, typed, dependency-free TypeScript packages",
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "^2.29.7",
    "@vitest/coverage-v8": "5.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "license": "MIT",
  "name": "adrienlcp-packages",
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "changeset": "changeset",
    "lint": "biome check --write",
    "lint:ci": "biome ci",
    "preinstall": "git config core.hooksPath .githooks || true",
    "release": "pnpm build && changeset publish",
    "test": "pnpm -r test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/safe-storage && tsc --noEmit -p packages/theme-preference",
    "validate": "pnpm build && pnpm typecheck && pnpm lint:ci && pnpm test"
  },
  "type": "module",
  "version": "0.0.0"
}

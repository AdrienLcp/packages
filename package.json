{
  "author": "Adrien Lacourpaille",
  "description": "Small, typed, dependency-free TypeScript packages",
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "^3.0.3",
    "@vitest/coverage-v8": "5.0.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "license": "MIT",
  "name": "adrienlcp-packages",
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "changeset": "changeset",
    "lint": "biome check --write",
    "lint:ci": "biome ci",
    "preinstall": "git config core.hooksPath .githooks || true",
    "release": "pnpm build && changeset publish",
    "test": "pnpm -r test",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/browser && tsc --noEmit -p packages/react && tsc --noEmit -p packages/react-aria && tsc --noEmit -p packages/react-router && tsc --noEmit -p packages/safe-storage && tsc --noEmit -p packages/theme-preference",
    "validate": "pnpm build && pnpm typecheck && pnpm lint:ci && pnpm test"
  },
  "type": "module",
  "version": "0.0.0"
}

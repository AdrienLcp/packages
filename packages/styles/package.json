{
  "author": "Adrien Lacourpaille",
  "bugs": "https://github.com/AdrienLcp/packages/issues",
  "description": "A reset, a reduced-motion switch, and Sass mixins for self-hosted fonts, a breakpoint, focus rings and pointer-only hover",
  "devDependencies": {
    "sass": "^1.105.0"
  },
  "exports": {
    "./breakpoints": {
      "sass": "./src/_breakpoints.sass"
    },
    "./focus": {
      "sass": "./src/_focus.sass"
    },
    "./fonts": {
      "sass": "./src/_fonts.sass"
    },
    "./package.json": "./package.json",
    "./reduced-motion.css": "./src/reduced-motion.css",
    "./reset.css": "./src/reset.css"
  },
  "files": [
    "src/*.css",
    "src/*.sass"
  ],
  "homepage": "https://github.com/AdrienLcp/packages/tree/main/packages/styles#readme",
  "keywords": [
    "css",
    "focus-visible",
    "font-face",
    "reset",
    "sass"
  ],
  "license": "MIT",
  "name": "@adrienlcp/styles",
  "peerDependencies": {
    "sass": ">=1.80.0"
  },
  "peerDependenciesMeta": {
    "sass": {
      "optional": true
    }
  },
  "repository": {
    "directory": "packages/styles",
    "type": "git",
    "url": "git+https://github.com/AdrienLcp/packages.git"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest --watch"
  },
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "version": "0.1.0"
}

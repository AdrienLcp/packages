{
  "author": "Adrien Lacourpaille",
  "bugs": "https://github.com/AdrienLcp/packages/issues",
  "dependencies": {
    "@adrienlcp/result": "workspace:^",
    "culori": "^4.0.2"
  },
  "description": "A reset, a reduced-motion switch, default tokens, Sass mixins for self-hosted fonts, container queries, a breakpoint, focus rings, visually hidden text, a two-column spread, a skip link that clears the notch and an entrance on the first landing, a fluid size in rem, a Sass importer that serves values a script shares, a PostCSS plugin that lists Arial's metric twins in fontaine's fallback faces, and checks for WCAG contrast between colour tokens, for sizes the user's font size cannot reach, for font tokens that skip their fallback face, for fallback bands that miss a weight and for SVG text that names a family",
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.3",
    "lightningcss": "^1.33.0",
    "postcss": "^8.5.28",
    "sass": "^1.105.0"
  },
  "exports": {
    "./accessibility": {
      "sass": "./src/_accessibility.sass"
    },
    "./audit": "./dist/audit.js",
    "./breakpoints": {
      "sass": "./src/_breakpoints.sass"
    },
    "./containers": {
      "sass": "./src/_containers.sass"
    },
    "./contrast": "./dist/contrast.js",
    "./fonts": {
      "sass": "./src/_fonts.sass"
    },
    "./metric-twins": "./dist/metric-twins.js",
    "./motion": {
      "sass": "./src/_motion.sass"
    },
    "./package.json": "./package.json",
    "./reduced-motion.css": "./src/reduced-motion.css",
    "./reset.css": "./src/reset.css",
    "./sass-values": "./dist/sass-values.js",
    "./sizes": {
      "sass": "./src/_sizes.sass"
    },
    "./spread": {
      "sass": "./src/_spread.sass"
    },
    "./text-box": {
      "sass": "./src/_text-box.sass"
    },
    "./tokens": {
      "sass": "./src/_tokens.sass"
    }
  },
  "files": [
    "dist",
    "src/*.css",
    "src/*.sass"
  ],
  "homepage": "https://adrienlcp.com/en/projects/packages#package-styles",
  "keywords": [
    "contrast",
    "css",
    "font-face",
    "font-fallback",
    "fontaine",
    "postcss",
    "reset",
    "sass",
    "wcag"
  ],
  "license": "MIT",
  "name": "@adrienlcp/styles",
  "peerDependencies": {
    "sass": ">=1.80.0"
  },
  "peerDependenciesMeta": {
    "sass": {
      "optional": true
    }
  },
  "repository": {
    "directory": "packages/styles",
    "type": "git",
    "url": "git+https://github.com/AdrienLcp/packages.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest --watch"
  },
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "version": "0.17.0"
}

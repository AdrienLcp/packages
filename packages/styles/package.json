{
  "author": "Adrien Lacourpaille",
  "bugs": "https://github.com/AdrienLcp/packages/issues",
  "dependencies": {
    "@adrienlcp/result": "workspace:^"
  },
  "description": "A reset, a reduced-motion switch, Sass mixins for self-hosted fonts, container queries and a breakpoint, and a WCAG contrast check for colour tokens",
  "devDependencies": {
    "sass": "^1.105.0"
  },
  "exports": {
    "./breakpoints": {
      "sass": "./src/_breakpoints.sass"
    },
    "./containers": {
      "sass": "./src/_containers.sass"
    },
    "./contrast": "./dist/contrast.js",
    "./fonts": {
      "sass": "./src/_fonts.sass"
    },
    "./package.json": "./package.json",
    "./reduced-motion.css": "./src/reduced-motion.css",
    "./reset.css": "./src/reset.css"
  },
  "files": [
    "dist",
    "src/*.css",
    "src/*.sass"
  ],
  "homepage": "https://github.com/AdrienLcp/packages/tree/main/packages/styles#readme",
  "keywords": [
    "contrast",
    "css",
    "font-face",
    "reset",
    "sass",
    "wcag"
  ],
  "license": "MIT",
  "name": "@adrienlcp/styles",
  "peerDependencies": {
    "sass": ">=1.80.0"
  },
  "peerDependenciesMeta": {
    "sass": {
      "optional": true
    }
  },
  "repository": {
    "directory": "packages/styles",
    "type": "git",
    "url": "git+https://github.com/AdrienLcp/packages.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest --watch"
  },
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "version": "0.5.0"
}

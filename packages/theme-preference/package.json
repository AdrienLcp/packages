{
  "author": "Adrien Lacourpaille",
  "bugs": "https://github.com/AdrienLcp/packages/issues",
  "dependencies": {
    "@adrienlcp/safe-storage": "workspace:^"
  },
  "description": "Light, dark or system theme with no flash on load, and a browser toolbar that follows the choice, and Sass mixins for a value per theme that light-dark() cannot carry",
  "devDependencies": {
    "@types/react": "19.3.0",
    "happy-dom": "20.14.5",
    "react": "19.3.0",
    "sass": "^1.105.0",
    "vite": "8.3.1"
  },
  "exports": {
    ".": "./dist/index.js",
    "./color-scheme.css": "./color-scheme.css",
    "./package.json": "./package.json",
    "./react": "./dist/use-theme-preference.js",
    "./scheme": {
      "sass": "./_scheme.sass"
    },
    "./vite": "./dist/theme-preference-vite-plugin.js"
  },
  "files": [
    "_scheme.sass",
    "color-scheme.css",
    "dist"
  ],
  "homepage": "https://adrienlcp.com/en/projects/packages#package-theme-preference",
  "keywords": [
    "color-scheme",
    "dark-mode",
    "sass",
    "theme",
    "theme-color",
    "typescript"
  ],
  "license": "MIT",
  "name": "@adrienlcp/theme-preference",
  "peerDependencies": {
    "react": ">=18",
    "sass": ">=1.80.0",
    "vite": ">=7"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "sass": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "repository": {
    "directory": "packages/theme-preference",
    "type": "git",
    "url": "git+https://github.com/AdrienLcp/packages.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest --watch"
  },
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "version": "0.4.0"
}

  "name": "@adrienlcp/measure-font",
  "repository": {
    "directory": "packages/measure-font",
    "type": "git",
    "url": "git+https://github.com/AdrienLcp/packages.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
